# Proveedores soportados en model.py: google_genai | lmstudio | se pueden agregar más si es necesario
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-2.5-flash

# --- Google Gemini ---
# Clave desde https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_aqui

# --- LM Studio (modelo local) ---
# Solo si MODEL_PROVIDER=lmstudio
# MODEL_NAME debe ser el identificador exacto del modelo cargado en LM Studio
# el puerto puede variar según tu configuración de LM Studio, verificar en la pestaña "Developer"
LMSTUDIO_BASE_URL=http://localhost:1234/v1